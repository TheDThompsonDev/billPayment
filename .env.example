DATABASE_URL="file:./demo.db"
# Required for general PDF/image interpretation (samples and manual entry need no key).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Explicit limited text-pattern mode for offline demos only; never a silent fallback.
# BILL_EXTRACTION_MODE=offline
# Browser payments use the local simulator or explicitly registered hosted demos.
# Real vendor execution requires PAYMENT_BROWSER_LIVE_ENABLED=true.
PAYMENT_DEMO_ORIGIN="http://127.0.0.1:3002"
# PAYMENT_BROWSER_MODEL=gpt-4.1-mini
# PAYMENT_DISCOVERY_MODEL=gpt-4.1-mini
# PAYMENT_BROWSER_LIVE_ENABLED=false
# Exact HTTPS origins for hosted fictional portals; never a wildcard or domain suffix.
# PAYMENT_BROWSER_DEMO_ORIGINS=https://your-fictional-portal.example
# Published test credentials for those registered demos only.
# PAYMENT_BROWSER_DEMO_EMAIL=
# PAYMENT_BROWSER_DEMO_PASSWORD=
# PAYMENT_BROWSER_STATE_DIR=storage/browser-sessions
# PAYMENT_BROWSER_ALLOWED_ORIGINS=https://verified-processor.example
