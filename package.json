{
  "name": "dsd-property-bill-automation",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "db:setup": "node scripts/init-db.mjs && prisma generate && prisma db push && tsx src/database/seed.ts",
    "db:seed": "tsx src/database/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "demo:fixtures": "tsx scripts/create-samples.ts",
    "demo:reset": "node scripts/reset-demo.mjs && npm run db:setup",
    "format": "prettier --write src tests e2e scripts README.md docs/*.md *.ts *.json *.mjs .github .prettierrc.json",
    "format:check": "prettier --check src tests e2e scripts README.md docs/*.md *.ts *.json *.mjs .github .prettierrc.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "verify": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.9",
    "prisma": "6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
